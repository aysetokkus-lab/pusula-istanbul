{
  "expo": {
    "name": "Pusula İstanbul",
    "slug": "pusula-istanbul",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pusulaistanbul",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pusulaistanbul.app",
      "usesAppleSignIn": true,
      "buildNumber": "46",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Konumunuz yakındaki müze ve ulaşım bilgilerini göstermek için kullanılır.",
        "NSPhotoLibraryUsageDescription": "Sohbette görsel paylaşmak, duyuru görseli ve masraf fişi yüklemek için fotoğraflarınıza erişim gerekir.",
        "NSPhotoLibraryAddUsageDescription": "Duyuru görsellerini cihaza kaydetmek için izin gerekir.",
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Sohbette sahadan fotoğraf çekip paylaşmak ve masraf fişi çekmek için kamera erişimi gerekir."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pusulaistanbul.app",
      "versionCode": 46,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1E40AF",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/fix-buildconfig",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#1E40AF",
          "dark": {
            "backgroundColor": "#1E40AF"
          },
          "android": {
            "image": "./assets/images/splash-icon-android.png",
            "imageWidth": 240,
            "resizeMode": "contain",
            "backgroundColor": "#1E40AF",
            "dark": {
              "backgroundColor": "#1E40AF"
            }
          },
          "ios": {
            "image": "./assets/images/splash-logo.png",
            "imageWidth": 100,
            "resizeMode": "contain",
            "backgroundColor": "#1E40AF",
            "dark": {
              "backgroundColor": "#1E40AF"
            }
          }
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sohbette görsel paylaşmak, duyuru görseli ve masraf fişi yüklemek için fotoğraflarınıza erişim gerekir.",
          "cameraPermission": "Sohbette sahadan fotoğraf çekip paylaşmak ve masraf fişi çekmek için kamera erişimi gerekir."
        }
      ],
      "expo-mail-composer",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4b230ae7-f56f-4c77-af07-acfcdea0efe6"
      }
    },
    "owner": "pusula-istanbul-app",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4b230ae7-f56f-4c77-af07-acfcdea0efe6"
    }
  }
}
